      {
        "type": "heading",
        "defaultValue": "Global Preferences"
      },
      {
        "type": "toggle",
        "messageKey": "TemperatureUnit",
        "label": "Use Fahrenheit (\u00b0F)",
        "defaultValue": false
      },
      {
        "type": "slider",
        "messageKey": "Tz2Offset",
        "label": "Second Timezone (UTC offset)",
        "defaultValue": 0,
        "min": -12,
        "max": 14,
        "step": 1
      },
      {
        "type": "slider",
        "messageKey": "Tz3Offset",
        "label": "Third Timezone (UTC offset)",
        "defaultValue": 0,
        "min": -12,
        "max": 14,
        "step": 1
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Custom Web API"
      },
      {
        "type": "input",
        "messageKey": "CustomApiUrl",
        "label": "Endpoint URL",
        "defaultValue": "",
        "attributes": {
          "placeholder": "https://api.example.com/status",
          "type": "url"
        }
      },
      {
        "type": "input",
        "messageKey": "CustomApiRegex",
        "label": "Extract Regex",
        "defaultValue": "\"summary\"\\s*:\\s*\"?([^\"]+)\"?",
        "attributes": {
          "placeholder": "\"summary\"\\s*:\\s*\"?([^\"]+)\"?",
          "type": "text"
        },
        "description": "First capture group is sent to the watch (max 12 chars)."
      },
      {
        "type": "input",
        "messageKey": "CustomApiAuth",
        "label": "Auth Header (optional)",
        "defaultValue": "",
        "attributes": {
          "placeholder": "Bearer myApiToken123",
          "type": "text"
        }
      }
    ]
  },
  {
    "type": "submit",
    "defaultValue": "Save Settings"
  }
